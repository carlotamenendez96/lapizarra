# Copia este archivo a .env y rellena los valores reales.

# Panel de Supabase → Settings → Data API
SUPABASE_URL=https://oeuobixauwbdfuinmhvy.supabase.co

# Settings → API Keys → publishable key (o la antigua "anon").
# Es una clave pública de solo lectura: las tablas están protegidas por RLS.
