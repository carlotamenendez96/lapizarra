# Dominio final, sin barra al final. Se usa en las URLs canónicas,
# el sitemap y las etiquetas para redes sociales.
SITE_URL=https://lapizarra.es

# Enlace de contacto del comercial (WhatsApp).
# El comercial es quien envía al hostelero su URL de alta en Telegram.
CONTACTO_COMERCIAL_URL=https://wa.me/34645475153
